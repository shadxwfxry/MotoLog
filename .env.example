# ─── Database (Prisma → Supabase Postgres) ───────────────────────────────────
# DATABASE_URL goes through the connection pooler; DIRECT_URL bypasses it and is
# used for migrations, which cannot run over a transaction pooler.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── AI assistant (optional) ─────────────────────────────────────────────────
# Google Gemini key. Without it the assistant reports itself as unconfigured
# rather than failing.
AI_API_KEY=""

# ─── Tournaments (optional) ──────────────────────────────────────────────────
NEXT_PUBLIC_BRACKET_URL="https://motobracket.com"

# ─── Group rides: realtime transport ─────────────────────────────────────────
# Supabase Realtime carries live positions and chat. Data still goes through
# Prisma — these are used for the channel only.
#
# Project Settings → API for the first two; Project Settings → API → JWT Settings
# for the secret. The anon key is public by design and ships in the client
# bundle; the JWT secret is server-only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# Feature flags. Multiplayer stays off until the three values above are set.
NEXT_PUBLIC_FEATURE_MULTIPLAYER="false"

# ─── Group rides: optional P2P upgrade ───────────────────────────────────────
# Direct peer connections for lower latency. The relay above always carries
# everything regardless, so leaving this off costs latency, never correctness.
NEXT_PUBLIC_FEATURE_P2P="false"

# TURN relay. Public STUN handles most networks, but symmetric NAT and many
# mobile carriers need TURN. Without it those peers silently fall back to the
# Supabase relay — the designed behaviour, not a failure.
NEXT_PUBLIC_TURN_URL=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""
